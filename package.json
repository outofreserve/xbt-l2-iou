{
  "name": "btc-l2-iou-system",
  "version": "0.1.0",
  "description": "Bitcoin Layer 2 IOU System — dual-layer blockchain simulation using Nostr-style events as tradeable IOUs backed 1:1 by Bitcoin locked in HTLCs.",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
